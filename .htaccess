RewriteEngine On

# Global redirect: www to non-www
RewriteCond %{HTTP_HOST} ^www\.csrlandmarkresorts\.com$ [NC]
RewriteRule ^(.*)$ https://csrlandmarkresorts.com/$1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^dayout_resort_in_coimbatore\.html$ /dayout-resort-in-coimbatore.html [R=301,L]
RewriteRule ^Resort-Near-Isha\.html$ /resort-near-isha.html [R=301,L]


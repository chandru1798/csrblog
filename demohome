:root{--csr-dark:#17211d;--csr-green:#2f5b45;--csr-gold:#c79b5a;--csr-cream:#f7f3ec;--csr-white:#fff;--csr-text:#26312b;--csr-muted:#6d766f;--csr-radius:20px;--csr-shadow:0 18px 50px rgba(20,35,27,.10)}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;color:var(--csr-text);background:#fff;font-family:Arial,Helvetica,sans-serif}
img{max-width:100%;height:auto}
a{text-decoration:none}
button{font:inherit}
.demo-wrap{overflow:hidden}
.container{width:100%;max-width:1200px;margin:0 auto;padding:0 20px}
.demo-topbar{background:var(--csr-dark);color:#fff;font-size:13px;padding:9px 0}
.demo-topbar .inner{display:flex;justify-content:space-between;gap:20px;align-items:center}
.demo-topbar a{color:#fff}
.demo-header{position:absolute;z-index:20;top:38px;left:0;right:0;padding:14px 0}
.demo-header-inner{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.96);border-radius:18px;padding:9px 12px 9px 18px;box-shadow:0 10px 35px rgba(0,0,0,.12)}
.demo-logo{display:flex;align-items:center;gap:12px;color:var(--csr-dark);font-weight:700}
.demo-logo img{width:62px;height:62px;object-fit:contain;border-radius:50%}
.demo-logo span{line-height:1.05;font-size:15px}
.demo-logo small{display:block;font-size:10px;letter-spacing:1.3px;font-weight:500;margin-top:4px;color:#68726c}
.demo-nav{display:flex;align-items:center;gap:7px}
.demo-nav a{color:#25322b;padding:11px 12px;font-size:13px;font-weight:600;border-radius:10px}
.demo-nav a:hover{background:var(--csr-cream)}
.demo-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:13px 20px;border-radius:999px;background:var(--csr-green);color:#fff!important;font-weight:700;border:1px solid var(--csr-green);transition:transform .2s,background .2s}
.demo-btn:hover{transform:translateY(-1px);background:#234936}
.demo-btn.light{background:#fff;color:var(--csr-green)!important;border-color:#fff}
.demo-btn.outline{background:transparent;color:var(--csr-green)!important;border-color:#b9c7bd}
.demo-menu{display:none;border:0;background:transparent;font-size:26px;cursor:pointer}
.demo-mobile-nav{display:none;background:#fff;border-radius:14px;margin-top:7px;padding:12px;box-shadow:0 10px 30px rgba(0,0,0,.15)}
.demo-mobile-nav.is-open{display:block}
.demo-mobile-nav a{display:block;padding:9px;color:#26312b}
.demo-mobile-nav .demo-btn{margin-top:7px;width:100%}

.demo-hero{min-height:720px;position:relative;color:#fff;display:flex;align-items:center;isolation:isolate;overflow:hidden}
.demo-hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.demo-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,25,18,.72),rgba(10,25,18,.30));z-index:-1}
.demo-hero-content{padding-top:115px;max-width:760px}
.eyebrow{font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:700;color:var(--csr-gold);margin-bottom:14px}
.demo-hero h1{font-size:clamp(40px,6vw,72px);line-height:1.02;margin:0 0 20px;color:#fff;font-weight:700}
.demo-hero p{font-size:19px;line-height:1.65;max-width:650px;margin:0 0 28px;color:rgba(255,255,255,.9)}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px}
.hero-trust{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
.hero-trust span{padding:9px 13px;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);border-radius:999px;font-size:12px}

.experience-bar{margin-top:-42px;position:relative;z-index:5}
.experience-grid{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border-radius:22px;box-shadow:var(--csr-shadow);overflow:hidden}
.experience-card{padding:24px 23px;border-right:1px solid #e8ece8;display:block;color:var(--csr-text);transition:background .2s,transform .2s}
.experience-card:last-child{border-right:0}
.experience-card:hover{background:#fbfaf7;transform:translateY(-2px)}
.experience-icon{font-size:25px;color:var(--csr-green);margin-bottom:11px}
.experience-card h3{font-size:19px;margin:0 0 7px}
.experience-card p{font-size:13px;line-height:1.55;color:var(--csr-muted);margin:0 0 10px}
.experience-card strong{font-size:12px;color:var(--csr-green)}

.demo-section{padding:105px 0}
.demo-section.cream{background:var(--csr-cream)}
.section-head{max-width:760px;margin-bottom:42px}
.section-head.center{text-align:center;margin-left:auto;margin-right:auto}
.section-head h2{font-size:clamp(31px,4vw,48px);line-height:1.12;margin:0 0 14px;color:var(--csr-dark)}
.section-head p{color:var(--csr-muted);font-size:16px;line-height:1.7;margin:0}
.section-kicker{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--csr-green);font-weight:800;margin-bottom:10px}

.about-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:65px;align-items:center}
.about-images{display:grid;grid-template-columns:1fr .72fr;gap:15px;align-items:end}
.about-images img{width:100%;height:520px;object-fit:cover;border-radius:var(--csr-radius)}
.about-images img:last-child{height:360px;margin-bottom:-35px}
.about-copy h2{font-size:43px;line-height:1.1;color:var(--csr-dark);margin:0 0 18px}
.about-copy p{line-height:1.8;color:var(--csr-muted)}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:25px 0}
.fact{background:#fff;border:1px solid #e5e9e5;border-radius:14px;padding:15px}
.fact strong{display:block;color:var(--csr-dark);font-size:20px}
.fact span{font-size:12px;color:var(--csr-muted)}

.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.room-card{background:#fff;border-radius:var(--csr-radius);overflow:hidden;box-shadow:0 10px 35px rgba(20,35,27,.08);border:1px solid #edf0ed}
.room-card figure{margin:0;position:relative}
.room-card img{width:100%;height:275px;object-fit:cover;display:block}
.room-card .tag{position:absolute;left:15px;top:15px;background:#fff;padding:7px 10px;border-radius:999px;font-size:11px;font-weight:700;color:var(--csr-green)}
.room-card-body{padding:21px}
.room-card h3{font-size:22px;margin:0 0 8px;color:var(--csr-dark)}
.room-card p{font-size:13px;color:var(--csr-muted);line-height:1.6;min-height:42px}
.card-link{font-size:13px;font-weight:800;color:var(--csr-green)}
.card-actions{display:flex;gap:8px;margin-top:15px;flex-wrap:wrap}
.small-btn{padding:9px 13px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid #d7ded8;color:var(--csr-green)}
.small-btn.primary{background:var(--csr-green);color:#fff;border-color:var(--csr-green)}

.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.feature{padding:23px;background:#fff;border-radius:16px;border:1px solid #e7ebe7}
.feature .icon{font-size:25px;margin-bottom:12px;color:var(--csr-green)}
.feature h3{font-size:16px;margin:0 0 6px}
.feature p{font-size:12px;color:var(--csr-muted);margin:0;line-height:1.5}

.split{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch}
.split-img{min-height:520px;position:relative;overflow:hidden;border-radius:20px 0 0 20px}
.split-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.split-copy{background:var(--csr-dark);color:#fff;padding:65px;border-radius:0 20px 20px 0;display:flex;flex-direction:column;justify-content:center}
.split-copy h2{font-size:42px;line-height:1.1;margin:0 0 18px}
.split-copy p{color:rgba(255,255,255,.78);line-height:1.75}
.check-list{list-style:none;padding:0;margin:22px 0}
.check-list li{padding:8px 0;color:#fff;font-size:14px}
.check-list li:before{content:"✓";color:var(--csr-gold);font-weight:800;margin-right:10px}

.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.review{background:#fff;padding:27px;border-radius:18px;border:1px solid #e7ebe7}
.stars{color:#d09d35;letter-spacing:2px;margin-bottom:13px}
.review p{font-size:14px;line-height:1.75;color:#4e5952}
.review strong{font-size:13px;color:var(--csr-dark)}

.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.blog-card{border-radius:18px;overflow:hidden;background:#fff;border:1px solid #e7ebe7}
.blog-card img{width:100%;height:220px;object-fit:cover;display:block}
.blog-body{padding:20px}
.blog-body small{color:var(--csr-green);font-weight:700}
.blog-body h3{font-size:19px;line-height:1.3;margin:9px 0}
.blog-body p{font-size:13px;line-height:1.6;color:var(--csr-muted)}

.final-cta{background:linear-gradient(100deg,#244735,#3d6950);color:#fff;border-radius:24px;padding:65px 60px;display:flex;align-items:center;justify-content:space-between;gap:30px}
.final-cta h2{font-size:40px;margin:0 0 10px}
.final-cta p{margin:0;color:rgba(255,255,255,.8)}

.demo-footer{background:#131b17;color:#fff;padding:65px 0 20px}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.3fr;gap:40px}
.demo-footer h4{font-size:14px;text-transform:uppercase;letter-spacing:1px;margin:0 0 18px}
.demo-footer p,.demo-footer li{font-size:13px;line-height:1.8;color:#bfc8c1}
.demo-footer ul{list-style:none;padding:0;margin:0}
.demo-footer a{color:#bfc8c1}
.demo-footer a:hover{color:#fff}
.copyright{border-top:1px solid rgba(255,255,255,.1);margin-top:35px;padding-top:18px;font-size:12px;color:#8f9a92}
.mobile-cta{display:none}



.video-section{padding:72px 0 40px;background:#fff}
.video-card{position:relative;max-width:1120px;margin:0 auto;border-radius:24px;overflow:hidden;background:#17211d;box-shadow:0 18px 50px rgba(20,35,27,.14);aspect-ratio:16/9}
.video-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.video-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(90deg,rgba(10,25,18,.48),rgba(10,25,18,.16));cursor:pointer;border:0;width:100%;height:100%;color:#fff}
.video-play{width:78px;height:78px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff;color:#2f5b45;box-shadow:0 10px 30px rgba(0,0,0,.25);font-size:30px;padding-left:5px;transition:transform .2s,box-shadow .2s}
.video-overlay:hover .video-play{transform:scale(1.06);box-shadow:0 14px 36px rgba(0,0,0,.32)}
.video-label{position:absolute;left:28px;bottom:25px;font-size:13px;font-weight:700;letter-spacing:.5px;text-shadow:0 2px 10px rgba(0,0,0,.4)}
.video-iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.video-note{max-width:760px;margin:18px auto 0;text-align:center;color:#6d766f;font-size:13px;line-height:1.6}

.enquiry-section{padding:90px 0;background:#f7f3ec}
.enquiry-card{display:grid;grid-template-columns:.82fr 1.18fr;background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 18px 50px rgba(20,35,27,.10);border:1px solid #e7ebe7}
.enquiry-intro{padding:48px;background:linear-gradient(145deg,#17211d,#315b45);color:#fff}
.enquiry-intro .section-kicker{color:#d8b77b}
.enquiry-intro h2{font-size:40px;line-height:1.12;margin:0 0 15px}
.enquiry-intro p{color:rgba(255,255,255,.78);line-height:1.75;margin:0 0 25px}
.enquiry-points{list-style:none;padding:0;margin:0}
.enquiry-points li{padding:9px 0;color:#fff;font-size:14px}
.enquiry-points li:before{content:"✓";color:#d8b77b;font-weight:800;margin-right:10px}
.enquiry-form{padding:48px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.form-field{display:flex;flex-direction:column;gap:7px}
.form-field.full{grid-column:1/-1}
.form-field label{font-size:12px;font-weight:800;color:#26312b}
.form-field label span{color:#b35a4b}
.form-field label small{font-weight:500;color:#7a837d}
.form-field input,.form-field select,.form-field textarea{width:100%;border:1px solid #dce3dd;border-radius:12px;background:#fbfcfb;padding:13px 14px;font:inherit;font-size:14px;color:#26312b;outline:0;transition:border-color .2s,box-shadow .2s}
.form-field input:focus,.form-field select:focus,.form-field textarea:focus{border-color:#2f5b45;box-shadow:0 0 0 3px rgba(47,91,69,.10)}
.form-field textarea{min-height:105px;resize:vertical}
.form-note{font-size:11px;color:#7a837d;margin:12px 0 18px;line-height:1.5}
.form-submit{width:100%;border:0;cursor:pointer}
.form-submit:hover{transform:translateY(-1px)}

@media(max-width:991px){
.demo-nav{display:none}.demo-menu{display:block}
.experience-grid{grid-template-columns:repeat(2,1fr)}
.experience-card:nth-child(2){border-right:0}
.experience-card:nth-child(-n+2){border-bottom:1px solid #e8ece8}
.about-grid,.split{grid-template-columns:1fr}
.about-images{margin-bottom:30px}.split-img{border-radius:20px 20px 0 0}.split-copy{border-radius:0 0 20px 20px}
.card-grid,.review-grid,.blog-grid{grid-template-columns:repeat(2,1fr)}
.feature-grid{grid-template-columns:repeat(3,1fr)}
.footer-grid{grid-template-columns:repeat(2,1fr)}
  .enquiry-card{grid-template-columns:1fr}.enquiry-intro{padding:38px}.enquiry-form{padding:38px}
}
@media(max-width:767px){
.demo-topbar{display:none}
.demo-header{top:10px}
.demo-header-inner{padding:6px 9px 6px 12px}
.demo-logo img{width:50px;height:50px}.demo-logo span{font-size:12px}.demo-logo small{font-size:8px}
.demo-hero{min-height:680px}
.demo-hero-content{padding-top:100px}
.demo-hero h1{font-size:42px}.demo-hero p{font-size:16px}
.experience-grid{grid-template-columns:1fr}
.experience-card{border-right:0!important;border-bottom:1px solid #e8ece8}
.experience-card:last-child{border-bottom:0}
.demo-section{padding:75px 0}
.about-images{grid-template-columns:1fr}.about-images img,.about-images img:last-child{height:330px;margin:0}
.about-copy h2{font-size:34px}.facts{grid-template-columns:1fr}
.card-grid,.review-grid,.blog-grid,.feature-grid{grid-template-columns:1fr}
.split-img{min-height:330px}.split-copy{padding:40px 28px}.split-copy h2{font-size:34px}
.final-cta{padding:40px 28px;display:block}.final-cta .demo-btn{margin-top:22px}
.footer-grid{grid-template-columns:1fr}.enquiry-section{padding:70px 0}.enquiry-form{padding:30px 22px}.enquiry-intro{padding:34px 22px}.enquiry-intro h2{font-size:32px}.form-grid{grid-template-columns:1fr}.form-field.full{grid-column:auto}
.mobile-cta{position:fixed;display:grid;grid-template-columns:repeat(3,1fr);bottom:0;left:0;right:0;z-index:100;background:#fff;box-shadow:0 -8px 25px rgba(0,0,0,.15)}
.mobile-cta a{padding:13px 5px;text-align:center;font-size:11px;font-weight:800;color:var(--csr-dark);border-right:1px solid #e4e8e4}
.mobile-cta a:last-child{background:var(--csr-green);color:#fff;border:0}
body{padding-bottom:53px}
}

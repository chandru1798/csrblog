<script>
(function(){
  var v = document.getElementById('video_home');
  if (!v) return;
  var src = v.getAttribute('data-src');
  if (!src) return;
  var loadAndPlay = function(){
    if (v.getAttribute('data-loaded')) return;
    v.setAttribute('data-loaded', '1');
    var s = document.createElement('source');
    s.src = src;
    s.type = 'video/mp4';
    v.appendChild(s);
    v.load();
    var p = v.play();
    if (p && p.catch) p.catch(function(){});
  };
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { loadAndPlay(); io.disconnect(); }
      });
    }, { rootMargin: '200px' });
    io.observe(v);
  } else {
    window.addEventListener('load', loadAndPlay);
  }
})();
</script>


<script>
(function () {
  var hero = document.querySelector('.csr-hero-video');
  var host = hero && hero.querySelector('.csr-hero-youtube');
  var loaded = false;

  function loadHeroVideo() {
    if (!hero || !host || loaded) return;
    loaded = true;

    var iframe = document.createElement('iframe');
    iframe.src =
      'https://www.youtube.com/embed/vY9sl6RpmWI?autoplay=1&mute=1&controls=0&loop=1&playlist=vY9sl6RpmWI&playsinline=1&rel=0&modestbranding=1';
    iframe.title = 'CSR Landmark Resorts hero video';
    iframe.allow = 'autoplay; encrypted-media; fullscreen';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';

    iframe.addEventListener('load', function () {
      host.classList.add('is-ready');
    }, { once: true });

    host.appendChild(iframe);
  }

  if (hero) {
    window.addEventListener('load', function () {
      window.setTimeout(loadHeroVideo, 3000);
    }, { once: true });

    /* If the visitor interacts with the hero, don't make them wait. */
    hero.addEventListener('pointerdown', loadHeroVideo, {
      once: true,
      passive: true
    });
  }
})();
</script>

